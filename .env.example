# ── Database ────────────────────────────────────────────────
# PostgreSQL 14+ with the btree_gist extension (Neon, Supabase, RDS, Render all have it).
# On serverless hosts use the provider's pooled connection string (e.g. Neon's "-pooler" host).
DATABASE_URL="postgres://smashpoint:smashpoint@localhost:5432/smashpoint"
# Optional: connections per app instance (default 10, or 5 on Vercel).
# DATABASE_POOL_MAX="10"

# ── Admin sign-in ───────────────────────────────────────────
# Required. Signs admin session cookies. Generate with: openssl rand -base64 32
# (changing it signs every administrator out)
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Read by `npm run db:deploy`: creates this administrator if it doesn't exist yet
# (password at least 12 characters). Afterwards, manage admins with `npm run admin -- …`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Public URL of the site (metadata, sitemap, email links).
# On Vercel it defaults to the project's production domain if left unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Razorpay ────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys while testing.
# Without keys the site still runs, but online booking is switched off.
# The key secret and webhook secret are server-side only — never expose them to the browser.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Account & Settings → Webhooks → https://<your-site>/api/payments/webhook/razorpay
# Events: payment.authorized, payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=""

# ── Email (optional) ────────────────────────────────────────
# Booking confirmations, reminders and refund notices via Resend (https://resend.com).
EMAIL_FROM="SmashPoint <bookings@your-domain.example>"
RESEND_API_KEY=""

# ── Scheduled jobs ──────────────────────────────────────────
# Protects /api/cron/reminders (called with: Authorization: Bearer <CRON_SECRET>), which
# releases expired holds, reconciles Razorpay payments/refunds and sends reminders.
# Generate with: openssl rand -hex 24
CRON_SECRET="change-me"

# ── Public demo only ────────────────────────────────────────
# Loads the demo facility (five courts + a demo admin, no bookings) into an EMPTY database.
SEED_DEMO_DATA="false"
